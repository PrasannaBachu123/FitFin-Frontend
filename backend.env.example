# ============================================
# Backend Environment Configuration
# ============================================
# Copy this file to your backend directory as .env
# Replace the placeholder values with your actual configuration

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# MongoDB Example:
# MONGODB_URI=mongodb://localhost:27017/fitfin
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fitfin

# PostgreSQL Example:
# DATABASE_URL=postgresql://username:password@localhost:5432/fitfin

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Gmail Configuration for Email Expense Fetching
# ============================================

# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# To generate:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Name it "FitFin App" and click Generate
# 6. Copy the 16-character password (no spaces)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ============================================
# Python Configuration
# ============================================

# Path to Python 3 executable
# Linux/Mac:
PYTHON_PATH=python3
# Windows:
# PYTHON_PATH=C:\Python39\python.exe
# Or if python3 is in PATH:
# PYTHON_PATH=python3

# Path to mail.py script (relative to backend root)
# Default assumes mail.py is in backend root directory
MAIL_SCRIPT_PATH=./mail.py

# ============================================
# CORS Configuration
# ============================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:4200

# ============================================
# API Rate Limiting
# ============================================
# Max requests per window
RATE_LIMIT_MAX=100
# Time window in minutes
RATE_LIMIT_WINDOW=15

# Email fetch specific rate limit
EMAIL_FETCH_LIMIT=10
EMAIL_FETCH_WINDOW=60

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
# Options: error, warn, info, debug

# ============================================
# External APIs
# ============================================
# Finnhub API (for stock prices)
FINNHUB_API_KEY=your-finnhub-api-key

# Alpha Vantage API (for stock prices)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
# 10MB in bytes (10 * 1024 * 1024)

ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.json

# ============================================
# Session Configuration
# ============================================
SESSION_SECRET=your-session-secret-key-change-this
SESSION_MAX_AGE=86400000
# 24 hours in milliseconds

# ============================================
# Email Service (for notifications - optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=FitFin App <noreply@fitfin.app>

# ============================================
# Redis Configuration (if using Redis for caching)
# ============================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ============================================
# Cloud Storage (if using AWS S3, Google Cloud, etc.)
# ============================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=fitfin-uploads

# ============================================
# Health Check Configuration
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================
# Feature Flags
# ============================================
ENABLE_EMAIL_FETCH=true
ENABLE_FILE_UPLOAD=true
ENABLE_GOOGLE_FIT=false
ENABLE_BUDGET_ALERTS=true

# ============================================
# Development/Testing
# ============================================
# Set to true to enable detailed error messages
DEBUG_MODE=true

# Set to true to seed database with sample data
SEED_DATABASE=false

# ============================================
# Security
# ============================================
# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# CORS whitelist (comma-separated)
CORS_WHITELIST=http://localhost:4200,http://localhost:3000

# Enable HTTPS redirect in production
FORCE_HTTPS=false

# ============================================
# Notes:
# ============================================
#
# 1. NEVER commit this .env file to version control
# 2. Add .env to your .gitignore file
# 3. Create a .env.example file with placeholder values for team members
# 4. Use different .env files for development, staging, and production
# 5. Store production secrets in a secure vault (AWS Secrets Manager, etc.)
# 6. Rotate secrets regularly, especially API keys and passwords
# 7. For Gmail App Password:
#    - Remove spaces when pasting (should be 16 characters with no spaces)
#    - Keep this password secure and never share it
#    - If compromised, revoke it immediately from Google Account settings
#
# ============================================
